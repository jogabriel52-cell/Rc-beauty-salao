# RC Beauty — configuração para hospedagem Apache/LiteSpeed (Hostinger).
# Copiada para dist/ no build. Não contém chaves nem endereços de projeto.

Options -Indexes
DirectoryIndex index.html

# Rotas da aplicação (React Router): qualquer caminho que não seja arquivo
# existente devolve index.html. O HTTPS é forçado pelo painel da Hostinger
# ("Forçar HTTPS"), não aqui, para evitar laço de redirecionamento atrás do proxy.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # A aplicação só conversa com o próprio site e com o Supabase (API, Auth e
  # Edge Functions). Revisar se outro serviço for adicionado.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"

  # index.html sempre revalidado; arquivos de assets/ têm hash no nome.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(js|css|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Nunca servir arquivos de ambiente ou mapas de código, se forem enviados por engano.
<FilesMatch "(^\.env|\.map$)">
  Require all denied
</FilesMatch>

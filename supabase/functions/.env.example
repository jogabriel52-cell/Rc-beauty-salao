# Copie para supabase/functions/.env (não versionado) no desenvolvimento local.
# Na nuvem, configure com `supabase secrets set`.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SITE_URL=http://localhost:5173

# WhatsApp Business Platform (Cloud API) — valores OFICIAIS só no ambiente
# aprovado. Sem eles, o envio fica desativado (503). Na stack local, os testes
# usam valores fictícios apenas para verificar assinatura/verificação.
# WHATSAPP_GRAPH_VERSION=
# WHATSAPP_ACCESS_TOKEN_GERAL=
# WHATSAPP_ACCESS_TOKEN_VIP=
WHATSAPP_APP_SECRET=segredo-ficticio-somente-local
WHATSAPP_VERIFY_TOKEN=token-ficticio-somente-local

# SDR IA (opcional; desligada sem chave e sem autorização da unidade)
# ANTHROPIC_API_KEY=
# SDR_MODEL=claude-opus-5-5
